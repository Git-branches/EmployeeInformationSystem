# ---------------------------------------------------------------
# Secrets — never commit these
# ---------------------------------------------------------------
config/local.php
config/google_token.json
config/google_oauth_client.json
config/google_credentials.json

# ---------------------------------------------------------------
# Runtime data — belongs to a running installation, not the source
# ---------------------------------------------------------------
uploads/photos/*
uploads/requirements/*
uploads/imports/*
!uploads/*/.gitkeep

backups/*.sql
*BACKUP*.sql
PRE-DOWNGRADE-BACKUP.sql

# ---------------------------------------------------------------
# Build output — regenerated by installer/build.ps1
# ---------------------------------------------------------------
installer/build/
installer/dist/
installer/templates/php.ini.generated

# ---------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log
